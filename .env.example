# HookSentry Environment Variables

# SQLite Veritabanı (Varsayılan Yerel Geliştirme)
DATABASE_URL="file:./dev.db"

# Alternatif: PostgreSQL / Supabase Canlı Veritabanı
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Uygulama URL'i
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron / Worker Gizli Anahtarı (Otomatik Retry Güvenliği için)
CRON_SECRET="hooksentry_cron_secret_change_me_in_prod"
